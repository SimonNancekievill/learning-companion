# Copy to .env and fill in: `cp .env.example .env`. Never commit .env.
# src/config/settings.py reads these via django-environ. Variables already set in the
# process environment (CI, container) take precedence over values in .env.

# Required. Django's cryptographic signing key; settings refuse to load without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (avoid values starting with `$`, django-environ treats those as variable references).
DJANGO_SECRET_KEY=change-me

# Optional, default False. True/1 enables debug pages - local development only.
DJANGO_DEBUG=True

# Optional, default empty. Comma-separated host names the site may be served under.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI API key for summaries and next steps. Placeholder for now; wired up by
# the OpenAI client service ticket (#17).
OPENAI_API_KEY=
